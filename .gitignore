# Rust
/target/
**/target/
Cargo.lock

# Compiled objects / shared libraries (build output, never source).
*.o
*.so
*.dll
*.dylib

# R
.Rhistory
.RData
.Rproj.user/
*.Rproj
crates/fitdistcp-r/src/rust/target/
# NOTE: crates/fitdistcp-r/man/ is NOT ignored — the roxygen2-generated .Rd
# files are committed so `R CMD build` produces a documented tarball without
# needing to run roxygenise first (regenerate with
# `R -e 'roxygen2::roxygenise(load_code = "source")'`).
crates/fitdistcp-r/src/Makevars.ucrt
crates/fitdistcp-r/src/Makevars.win

# W21 packaging: the vendored Rust tree for the R package is regenerated by
# tools/vendor-r-crate.sh (it is ~110 MB and must not be committed). The
# vendored core crate copy and the cargo vendor config are generated too.
crates/fitdistcp-r/src/rust/vendor/
crates/fitdistcp-r/src/rust/fitdistcp-core/
crates/fitdistcp-r/src/rust/.cargo/
crates/fitdistcp-r/src/rust/Cargo.lock
crates/fitdistcp-r/*.tar.gz
crates/fitdistcp-r/*.Rcheck/
# Local CRAN-simulation / R CMD check scratch dirs.
/.rcheck/
/.cransim/

# Packaging / build output (generated, never committed).
*.tar.gz
*.whl
*.Rcheck/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editor / OS
.DS_Store
.idea/
.vscode/

# W7 golden-fixture tooling: cloned reference package + generation scripts.
# The generated fixtures themselves live in tests/golden/ and ARE committed.
/tools/
