# Generated by rextendr; adapted for the standalone (CRAN-isolated) build.
#
# The R binding crate at ./rust is its own Cargo workspace root (it declares a
# `[workspace]` table) and depends on a vendored copy of the core crate shipped
# inside the package (./rust/fitdistcp-core). Third-party crates are vendored
# into ./rust/vendor by the `configure` script, so this build needs no network
# access once the tarball is unpacked.
#
# Cargo therefore writes its artifacts to ./rust/target (the crate's own
# workspace target dir), NOT to the repository's top-level target/.

TARGET_DIR = ./rust/target
LIBDIR = $(TARGET_DIR)/release
STATLIB = $(LIBDIR)/libfitdistcp_r.a
PKG_LIBS = -L$(LIBDIR) -lfitdistcp_r

all: C_clean

$(SHLIB): $(STATLIB)

$(STATLIB):
	cargo build --release --manifest-path=./rust/Cargo.toml

C_clean:
	rm -Rf $(SHLIB) $(STATLIB) $(OBJECTS)

clean:
	rm -Rf $(SHLIB) $(STATLIB) $(OBJECTS)
